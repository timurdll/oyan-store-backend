// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  password     String
  role         String
  firstName    String?
  lastName     String?
  dateOfBirth  DateTime?
  profileImage String?
  phoneNumber  String?
  basket       Basket?
  ratings      Rating[]
  favorites    Favorite[]
  orders       Order[]   // Обратная связь с заказами
  bonuses   Float    @default(0.0) // Начисленные бонусы
  holdingBonuses Float @default(0.0) // Бонусы на удержании
  notifications Notification[]  // Add this field
  preOrders    PreOrder[]
}

model Basket {
  id         Int            @id @default(autoincrement())
  user_id    Int    @unique  // Добавлен атрибут @unique
  user       User           @relation(fields: [user_id], references: [id])
  products   BasketProduct[]
}

model BasketProduct {
  basket_id Int
  product_id Int
  quantity   Int
  basket     Basket @relation(fields: [basket_id], references: [id])
  product    Product @relation(fields: [product_id], references: [id])
  @@id([basket_id, product_id]) // Уникальная комбинация корзины и продукта
}

model Product {
  id                     Int                     @id @default(autoincrement())
  name                   String                  @unique
  price                  Float
  rating                 Float?
  cover_image            String
  images                 String[]
  typeId                 Int
  type                   Type                    @relation(fields: [typeId], references: [id])
  basketProducts         BasketProduct[]
  productInfo            ProductInfo?
  ratings                Rating[]
  favorites              Favorite[]
  productCharacteristics ProductCharacteristic[]
  orderProducts          OrderProduct[]
  stock                  Int                     @default(0)
  preOrders              PreOrder[]
  
  // Новые поля для ссылок на маркетплейсы
  halyqLink              String?
  kaspiLink              String?
  satuLink               String?

  // Связь с переводами
  translations           ProductTranslation[]
}


model ProductInfo {
  id         Int      @id @default(autoincrement())
  product_id Int    @unique  // Добавлен атрибут @unique
  product    Product  @relation(fields: [product_id], references: [id])
  title      String
  description String
  
  // Связь с переводами
  translations   ProductInfoTranslation[]
}

model Rating {
  id         Int      @id @default(autoincrement())
  user_id    Int
  product_id Int
  user       User     @relation(fields: [user_id], references: [id])
  product    Product  @relation(fields: [product_id], references: [id])
  rate       Int
  @@unique([user_id, product_id]) // Один пользователь может оставить один рейтинг на товар
}


model Type {
  id              Int                     @id @default(autoincrement())
  name            String
  products        Product[] 
  characteristics Characteristic[]
  
  // Связь с переводами
  translations    TypeTranslation[]
}

model Characteristic {
  id              Int                     @id @default(autoincrement())
  name            String                  @unique
  type            Type                    @relation(fields: [typeId], references: [id])
  typeId          Int
  productCharacteristics ProductCharacteristic[]
  
  // Связь с переводами
  translations    CharacteristicTranslation[]
}

model ProductCharacteristic {
  id              Int                     @id @default(autoincrement())
  description     String
  product         Product                 @relation(fields: [productId], references: [id])
  productId       Int
  characteristic  Characteristic          @relation(fields: [characteristicId], references: [id])
  characteristicId Int
  
  // Связь с переводами
  translations    ProductCharacteristicTranslation[]
}
model Favorite {
  id         Int      @id @default(autoincrement())
  user_id    Int
  product_id Int
  user       User     @relation(fields: [user_id], references: [id])
  product    Product  @relation(fields: [product_id], references: [id])

  @@unique([user_id, product_id]) // Один пользователь может добавить каждый товар в избранное только один раз
}

model Order {
  id          Int          @id @default(autoincrement())
  userId      Int
  user        User         @relation(fields: [userId], references: [id])
  status      OrderStatus  @default(PENDING)
  totalPrice  Float
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  products    OrderProduct[]
  phoneNumber String       // Номер телефона для связи
  legalEntityInfo String?
}

model OrderProduct {
  id         Int      @id @default(autoincrement())
  orderId    Int
  productId  Int
  quantity   Int
  order      Order    @relation(fields: [orderId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])
}

enum OrderStatus {
  PENDING     // Ожидает обработки
  CONFIRMED   // Подтвержден менеджером
  PAID        // Оплачен
  COMPLETED   // Завершен
  CANCELED    // Отменен
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  message   String
  read      Boolean   @default(false)
  createdAt DateTime  @default(now())
}

model PreOrder {
  id         Int      @id @default(autoincrement())
  userId     Int
  productId  Int
  user       User     @relation(fields: [userId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])
  createdAt  DateTime @default(now())
}

// Модели для поддержки переводов

// Поддерживаемые языки
enum Language {
  RU    // Русский (по умолчанию)
  KK    // Казахский
}

// Перевод для товара
model ProductTranslation {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  language  Language
  name      String
  
  @@unique([productId, language])
}

// Перевод для информации о товаре
model ProductInfoTranslation {
  id           Int         @id @default(autoincrement())
  productInfoId Int
  productInfo  ProductInfo @relation(fields: [productInfoId], references: [id], onDelete: Cascade)
  language     Language
  title        String
  description  String
  
  @@unique([productInfoId, language])
}

// Перевод для типа товара
model TypeTranslation {
  id        Int      @id @default(autoincrement())
  typeId    Int
  type      Type     @relation(fields: [typeId], references: [id], onDelete: Cascade)
  language  Language
  name      String
  
  @@unique([typeId, language])
}

// Перевод для характеристики
model CharacteristicTranslation {
  id               Int             @id @default(autoincrement())
  characteristicId Int
  characteristic   Characteristic  @relation(fields: [characteristicId], references: [id], onDelete: Cascade)
  language         Language
  name             String
  
  @@unique([characteristicId, language])
}

// Перевод для значения характеристики продукта
model ProductCharacteristicTranslation {
  id                     Int                   @id @default(autoincrement())
  productCharacteristicId Int
  productCharacteristic  ProductCharacteristic @relation(fields: [productCharacteristicId], references: [id], onDelete: Cascade)
  language               Language
  description            String
  
  @@unique([productCharacteristicId, language])
}